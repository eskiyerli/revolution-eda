{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/eskiyerli/revolution-eda/master/revedaEditor/fileio/schemas/schematic.schema.json",
  "title": "Revolution EDA Schematic File",
  "description": "Schema for schematic design files",
  "type": "array",
  "minItems": 2,
  "items": [
    { "$ref": "#/$defs/viewHeader" },
    { "$ref": "#/$defs/gridSettings" }
  ],
  "additionalItems": { "$ref": "#/$defs/schematicItem" },
  "$defs": {
    "point": {
      "type": "array",
      "items": { "type": "number" },
      "minItems": 2,
      "maxItems": 2
    },
    "flipTuple": {
      "type": "array",
      "items": { "type": ["number", "integer"] },
      "minItems": 2,
      "maxItems": 2
    },
    "rectCoords": {
      "type": "array",
      "items": { "type": "number" },
      "minItems": 4,
      "maxItems": 4
    },
    "viewHeader": {
      "type": "object",
      "required": ["viewType"],
      "properties": {
        "viewType": { "type": "string", "enum": ["symbol", "schematic", "layout"] },
        "schemaVersion": { "type": "string" }
      }
    },
    "gridSettings": {
      "type": "object",
      "properties": {
        "snapGrid": {
          "type": "array",
          "items": { "type": ["number", "integer"] },
          "minItems": 2,
          "maxItems": 2
        }
      }
    },
    "schematicItem": {
      "oneOf": [
        { "$ref": "#/$defs/schematicSymbol" },
        { "$ref": "#/$defs/schematicNet" },
        { "$ref": "#/$defs/schematicPin" },
        { "$ref": "#/$defs/schematicText" },
        { "$ref": "#/$defs/schematicGroup" },
        { "$ref": "#/$defs/checkMarker" }
      ]
    },
    "checkMarker": {
      "type": "object",
      "required": ["type", "rule", "sev", "msg", "rects"],
      "properties": {
        "type": { "const": "mrk" },
        "rule": { "type": "string" },
        "sev": { "type": "string", "enum": ["error", "warning"] },
        "msg": { "type": "string" },
        "rects": {
          "type": "array",
          "items": { "$ref": "#/$defs/rectCoords" }
        }
      },
      "description": "persisted check violation markers; rebuilt into scene.lastCheckViolations on load"
    },
    "schematicSymbol": {
      "type": "object",
      "required": ["type", "lib", "cell", "view", "nam", "ic", "ld", "loc"],
      "properties": {
        "type": { "const": "sys" },
        "lib": { "type": "string" },
        "cell": { "type": "string" },
        "view": { "type": "string" },
        "nam": { "type": "string" },
        "ic": { "type": "integer" },
        "ld": { "type": "object" },
        "nst": { "type": "object",
                 "description": "netSet: inherited-connection overrides {exprName: localNetName} binding net expressions inside this instance's subcircuit" },
        "loc": { "$ref": "#/$defs/point" },
        "ang": { "type": "number" },
        "ign": { "type": "integer" },
        "br": { "$ref": "#/$defs/rectCoords" },
        "fl": { "$ref": "#/$defs/flipTuple" }
      }
    },
    "schematicNet": {
      "type": "object",
      "required": ["type", "st", "end", "nam", "ns"],
      "properties": {
        "type": { "const": "scn" },
        "st": { "$ref": "#/$defs/point" },
        "end": { "$ref": "#/$defs/point" },
        "nam": { "type": "string" },
        "ns": { "type": "integer" },
        "nx": { "type": "string",
                "description": "net expression '[@name[:default]]' evaluated by connectivity.resolve" }
      }
    },
    "schematicPin": {
      "type": "object",
      "required": ["type", "st", "pn", "pd", "pt"],
      "properties": {
        "type": { "const": "scp" },
        "st": { "$ref": "#/$defs/point" },
        "pn": { "type": "string" },
        "pd": { "type": "string", "enum": ["Input", "Output", "Inout"] },
        "pt": { "type": "string",
                "enum": ["Signal", "Ground", "Power", "Clock", "Digital", "Analog"] },
        "nx": { "type": "string",
                "description": "net expression '[@name[:default]]' evaluated by connectivity.resolve" },
        "ang": { "type": "number" },
        "fl": { "$ref": "#/$defs/flipTuple" }
      }
    },
    "schematicGroup": {
      "type": "object",
      "required": ["type", "loc", "items"],
      "properties": {
        "type": { "const": "Group" },
        "loc": { "$ref": "#/$defs/point" },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/schematicSymbol" }
        }
      },
      "description": "Persistent schematic mosaic containing independent symbols in group-local coordinates"
    },
    "schematicText": {
      "type": "object",
      "required": ["type", "st", "tc", "ff", "fs", "th", "ta", "to"],
      "properties": {
        "type": { "const": "txt" },
        "st": { "$ref": "#/$defs/point" },
        "tc": { "type": "string" },
        "ff": { "type": "string" },
        "fs": { "type": "string" },
        "th": { "type": ["number", "integer"] },
        "ta": { "type": "string" },
        "to": { "type": "string" },
        "ang": { "type": "number" },
        "fl": { "$ref": "#/$defs/flipTuple" }
      }
    }
  }
}
